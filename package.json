{
  "name": "trackflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/db",
    "apps/api",
    "apps/worker",
    "apps/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "prisma:generate": "npm run prisma:generate --workspace=packages/db",
    "prisma:migrate": "npm run prisma:migrate --workspace=packages/db"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "prisma": {
    "seed": "tsx packages/db/prisma/seed.ts"
  }
}
