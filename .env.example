# Local Environment Variables for development (Example)
PORT=3000
NODE_ENV=development

# JWT Secret
JWT_SECRET="your_super_secure_jwt_secret_here"

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/your_db_name?schema=public"

# Redis
# Format: redis://[host]:[port]/[db_index]
REDIS_URL="redis://localhost:6379/0"

# RabbitMQ
# Format: amqp://[user]:[password]@[host]:[port]/
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# Email / SMTP (Mailhog for local dev, real provider for production)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER="your_smtp_username_here"
SMTP_PASS="your_smtp_password_here"
SMTP_FROM="TrackFlow <noreply@yourdomain.com>"

# PDF / Storage Path
PDF_STORAGE_PATH="./storage/reports"
